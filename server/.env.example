# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. Everything here has a sensible default
# for local development, so an empty .env works too.
# ---------------------------------------------------------------------------

# Port the API listens on
PORT=4000

# Leave this EMPTY to auto-start a local MongoDB (data persists in
# server/.mongo-data). Set it to a real connection string to use Atlas or a
# mongod you installed yourself - no code changes needed.
MONGODB_URI=

# Secret used to sign JWTs. CHANGE THIS before deploying anywhere public.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=30d

# Allowed browser origins (comma separated). Expo web runs on 8081.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:4000

# Set to "production" to refuse auto-starting the local dev database
NODE_ENV=development
